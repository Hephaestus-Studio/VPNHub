{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPNHub",
  "mainBinaryName": "vpnhub",
  "version": "0.1.0",
  "identifier": "vpnhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VPNHub",
        "width": 980,
        "height": 660,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/vpnhub-daemon": "../../../target/release/vpnhub-daemon",
          "/usr/lib/systemd/system/vpnhub-daemon.service": "../../daemon/vpnhub-daemon.service"
        },
        "postInstallScript": "scripts/postinstall.sh",
        "preRemoveScript": "scripts/preremove.sh",
        "postRemoveScript": "scripts/postremove.sh"
      },
      "rpm": {
        "files": {
          "/usr/bin/vpnhub-daemon": "../../../target/release/vpnhub-daemon",
          "/usr/lib/systemd/system/vpnhub-daemon.service": "../../daemon/vpnhub-daemon.service"
        },
        "postInstallScript": "scripts/postinstall.sh",
        "preRemoveScript": "scripts/preremove.sh",
        "postRemoveScript": "scripts/postremove.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "scripts/windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
