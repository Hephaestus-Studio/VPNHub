<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hephaestus-studio.vpnhub.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/VPNHub.app/Contents/MacOS/vpnhub-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/vpnhub-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/vpnhub-daemon.error.log</string>
</dict>
</plist>
