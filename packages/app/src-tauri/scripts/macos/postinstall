#!/bin/sh
set -e

PLIST_SRC="/Applications/VPNHub.app/Contents/Resources/com.hephaestus-studio.vpnhub.daemon.plist"
PLIST_DEST="/Library/LaunchDaemons/com.hephaestus-studio.vpnhub.daemon.plist"

if [ -f "$PLIST_SRC" ]; then
    cp "$PLIST_SRC" "$PLIST_DEST"
    chown root:wheel "$PLIST_DEST"
    chmod 644 "$PLIST_DEST"

    # Bootstrap or load launchd service
    if launchctl list com.hephaestus-studio.vpnhub.daemon >/dev/null 2>&1; then
        launchctl bootout system "$PLIST_DEST" || true
    fi
    launchctl bootstrap system "$PLIST_DEST" || launchctl load -w "$PLIST_DEST" || true
fi
