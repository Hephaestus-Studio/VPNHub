{
  "name": "vpnhub-workspace",
  "private": true,
  "version": "0.1.1",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vpnhub/app dev",
    "build": "pnpm --filter @vpnhub/app build",
    "preview": "pnpm --filter @vpnhub/app preview",
    "tauri": "pnpm --filter @vpnhub/app tauri",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
